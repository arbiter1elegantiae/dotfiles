# Built-in theme; no external theme files required.
theme = Ayu Mirage

# Use Ghostty's bundled default font and styles.
font-size = 13

# Window
window-theme = auto
background-opacity = 0.96
# Padding is in points and scales with display DPI.
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Keep the block cursor at shell prompts and enable SSH environment compatibility.
shell-integration-features = no-cursor,ssh-env

# Slow down mouse scrolling.
mouse-scroll-multiplier = 0.95
